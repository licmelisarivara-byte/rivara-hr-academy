# Supabase (login de alumnos + tabla de compras de recursos)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (Project Settings > API > service_role). SECRETA: nunca la
# pongas en NEXT_PUBLIC_*, solo se usa server-side en /api/checkout y
# /api/mp-webhook para leer/escribir la tabla `compras`.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago Checkout Pro (Access Token de producción, no el de prueba)
MP_ACCESS_TOKEN=
# Opcional: "clave secreta" del webhook (Tu negocio > Webhooks en el panel de
# MP). Si la configurás acá y allá, el endpoint valida la firma de cada
# notificación antes de procesarla. Si la dejás vacía, igual es seguro: el
# webhook siempre re-confirma el pago contra la API de MP con el access token.
MP_WEBHOOK_SECRET=

# Resend (envío del PDF automático al comprador + aviso de alumnas nuevas)
RESEND_API_KEY=
SIGNUP_WEBHOOK_SECRET=

# URL pública del sitio (para los back_urls y el notification_url de Mercado Pago)
NEXT_PUBLIC_SITE_URL=https://hracademy.rivaraconsultora.com.ar
