# Supabase (login de alumnos + tabla de compras de recursos)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (Project Settings > API > service_role). SECRETA: nunca la
# pongas en NEXT_PUBLIC_*, solo se usa server-side en /api/checkout y
# /api/mp-webhook para leer/escribir la tabla `compras`.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago Checkout Pro (Access Token de producción, no el de prueba)
MP_ACCESS_TOKEN=
# Opcional: "clave secreta" del webhook (Tu negocio > Webhooks en el panel de
# MP). Si la configurás acá y allá, el endpoint valida la firma de cada
# notificación antes de procesarla. Si la dejás vacía, igual es seguro: el
# webhook siempre re-confirma el pago contra la API de MP con el access token.
MP_WEBHOOK_SECRET=

# Clave para aprobar a mano un pago por transferencia/Payoneer en
# /api/admin/approve-purchase (header "x-admin-secret"). Generar un valor
# random largo y no reusarlo de ningún otro lado.
ADMIN_SECRET=

# Resend (envío del PDF automático al comprador + aviso de alumnas nuevas)
RESEND_API_KEY=
SIGNUP_WEBHOOK_SECRET=

# URL pública del sitio (para los back_urls y el notification_url de Mercado Pago)
NEXT_PUBLIC_SITE_URL=https://hracademy.rivaraconsultora.com.ar

# Google Analytics 4 (flujo de datos propio de hracademy dentro de la cuenta
# de RIVARA Consultora). Si se deja vacía, el sitio no carga ningún script
# de analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta Pixel (Facebook/Instagram Ads). Si se deja vacía, no carga.
NEXT_PUBLIC_META_PIXEL_ID=

# Google Ads (Etiqueta de Google / seguimiento de conversiones). Si se deja
# vacía, no carga. Formato AW-XXXXXXXXX (Google Ads > Herramientas y
# configuración > Gestor de datos).
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Certificado de la masterclass "Analizá un CV con IA en segundos" (4/8).
# Respuesta correcta a la pregunta de verificación — actualizar si cambia
# el día del vivo. Acepta "42" o "42/100", sin distinguir mayúsculas/espacios.
CERTIFICADO_RESPUESTA_CORRECTA=42
# Opcional: si se deja vacía, usa el mismo link de YouTube de /masterclass.
CERTIFICADO_GRABACION_URL=

# Integración interna de Notion (notion.so/my-integrations), compartida con
# la base "📋 Inscriptos Masterclass 4/8". Si se deja vacía, el certificado
# se genera igual pero no se sincroniza nada a Notion.
NOTION_API_KEY=
